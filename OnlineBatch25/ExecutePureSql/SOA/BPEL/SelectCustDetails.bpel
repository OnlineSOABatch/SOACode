<?xml version = "1.0" encoding = "UTF-8" ?>
<!--
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  Oracle JDeveloper BPEL Designer 
  
  Created: Sun Mar 30 20:30:45 IST 2025
  Author:  MY PC
  Type: BPEL 2.0 Process
  Purpose: Synchronous BPEL Process
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
-->
<process name="SelectCustDetails"
               targetNamespace="http://xmlns.oracle.com/OnlineBatch25/ExecutePureSql/SelectCustDetails"
               xmlns="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
               xmlns:client="http://xmlns.oracle.com/OnlineBatch25/ExecutePureSql/SelectCustDetails"
               xmlns:ora="http://schemas.oracle.com/xpath/extension"
               xmlns:ui="http://xmlns.oracle.com/soa/designer"
               xmlns:bpelx="http://schemas.oracle.com/bpel/extension"
         xmlns:bpel="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:ns1="http://xmlns.oracle.com/pcbpel/adapter/db/OnlineBatch25/ExecutePureSql/SelectDetails"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:ns2="http://xmlns.oracle.com/pcbpel/adapter/db/SelectDetails">

    <import ui:processWSDL="true" namespace="http://xmlns.oracle.com/OnlineBatch25/ExecutePureSql/SelectCustDetails" location="../WSDLs/SelectCustDetails.wsdl" importType="http://schemas.xmlsoap.org/wsdl/"/>
    <!-- 
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        PARTNERLINKS                                                      
        List of services participating in this BPEL process               
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    --> 
  <partnerLinks>
    <!-- 
      The 'client' role represents the requester of this service. It is 
      used for callback. The location and correlation information associated
      with the client role are automatically set using WS-Addressing.
    -->
    <partnerLink name="selectcustdetails_client" partnerLinkType="client:SelectCustDetails" myRole="SelectCustDetailsProvider"/>
    <partnerLink name="SelectDetails" partnerLinkType="ns1:SelectDetails_plt" partnerRole="SelectDetails_role"/>
  </partnerLinks>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      VARIABLES                                                        
      List of messages and XML documents used within this BPEL process 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <variables>
    <!-- Reference to the message passed as input during initiation -->
    <variable name="inputVariable" messageType="client:SelectCustDetailsRequestMessage"/>

    <!-- Reference to the message that will be returned to the requester-->
    <variable name="outputVariable" messageType="client:SelectCustDetailsResponseMessage"/>
    <variable name="invokeSelectDetails_InputVariable" messageType="ns1:SelectDetailsInput_msg"/>
    <variable name="invokeSelectDetails_OutputVariable" messageType="ns1:SelectDetailsOutputCollection_msg"/>
  </variables>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
     ORCHESTRATION LOGIC                                               
     Set of activities coordinating the flow of messages across the    
     services integrated within this business process                  
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <sequence name="main">

    <!-- Receive input from requestor. (Note: This maps to operation defined in SelectCustDetails.wsdl) -->
    <receive name="receiveInput" partnerLink="selectcustdetails_client" portType="client:SelectCustDetails" operation="process" variable="inputVariable" createInstance="yes"/>
    <assign name="AssignInput">
      <copy>
        <from>$inputVariable.payload/client:Id</from>
        <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$invokeSelectDetails_InputVariable.SelectDetailsInput_msg/ns2:ID</to>
      </copy>
    </assign>
    <invoke name="InvokeSelectDetails" partnerLink="SelectDetails"
            portType="ns1:SelectDetails_ptt" operation="SelectDetails"
            inputVariable="invokeSelectDetails_InputVariable" outputVariable="invokeSelectDetails_OutputVariable"
            bpelx:invokeAsDetail="no"/>
    <assign name="AssignResponse">
      <copy>
        <from>$invokeSelectDetails_OutputVariable.SelectDetailsOutputCollection/ns2:SelectDetailsOutput/ns2:NAME</from>
        <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$outputVariable.payload/client:Name</to>
      </copy>
      <copy>
        <from>$invokeSelectDetails_OutputVariable.SelectDetailsOutputCollection/ns2:SelectDetailsOutput/ns2:CITY</from>
        <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$outputVariable.payload/client:City</to>
      </copy>
      <copy>
        <from>$invokeSelectDetails_OutputVariable.SelectDetailsOutputCollection/ns2:SelectDetailsOutput/ns2:CONTACTNUMBER</from>
        <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$outputVariable.payload/client:ContactNo</to>
      </copy>
    </assign>
    <!-- Generate reply to synchronous request -->
    <reply name="replyOutput" partnerLink="selectcustdetails_client" portType="client:SelectCustDetails" operation="process" variable="outputVariable"/>
  </sequence>
</process>