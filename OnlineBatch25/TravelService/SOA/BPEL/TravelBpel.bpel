<?xml version = "1.0" encoding = "UTF-8" ?>
<!--
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  Oracle JDeveloper BPEL Designer 
  
  Created: Wed Mar 19 11:41:31 IST 2025
  Author:  MY PC
  Type: BPEL 2.0 Process
  Purpose: Synchronous BPEL Process
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
-->
<process name="TravelBpel"
               targetNamespace="http://xmlns.oracle.com/OnlineBatch25/TravelService/TravelBpel"
               xmlns="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
               xmlns:client="http://xmlns.oracle.com/OnlineBatch25/TravelService/TravelBpel"
               xmlns:ora="http://schemas.oracle.com/xpath/extension"
               xmlns:ui="http://xmlns.oracle.com/soa/designer"
               xmlns:bpelx="http://schemas.oracle.com/bpel/extension"
         xmlns:bpel="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:oraext="http://www.oracle.com/XSL/Transform/java/oracle.tip.pc.services.functions.ExtFunc"
         xmlns:bpm="http://xmlns.oracle.com/bpmn20/extensions"
         xmlns:xp20="http://www.oracle.com/XSL/Transform/java/oracle.tip.pc.services.functions.Xpath20"
         xmlns:ess="http://xmlns.oracle.com/scheduler" xmlns:hwf="http://xmlns.oracle.com/bpel/workflow/xpath"
         xmlns:xref="http://www.oracle.com/XSL/Transform/java/oracle.tip.xref.xpath.XRefXPathFunctions"
         xmlns:dvm="http://www.oracle.com/XSL/Transform/java/oracle.tip.dvm.LookupValue"
         xmlns:bpws="http://schemas.xmlsoap.org/ws/2003/03/business-process/"
         xmlns:xdk="http://schemas.oracle.com/bpel/extension/xpath/function/xdk"
         xmlns:ids="http://xmlns.oracle.com/bpel/services/IdentityService/xpath"
         xmlns:ldap="http://schemas.oracle.com/xpath/extension/ldap" xmlns:ns1="http://www.example.org">

    <import ui:processWSDL="true" namespace="http://xmlns.oracle.com/OnlineBatch25/TravelService/TravelBpel" location="../WSDLs/TravelBpel.wsdl" importType="http://schemas.xmlsoap.org/wsdl/"/>
    <!-- 
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        PARTNERLINKS                                                      
        List of services participating in this BPEL process               
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    --> 
  <partnerLinks>
    <!-- 
      The 'client' role represents the requester of this service. It is 
      used for callback. The location and correlation information associated
      with the client role are automatically set using WS-Addressing.
    -->
    <partnerLink name="travelbpel_client" partnerLinkType="client:TravelBpel" myRole="TravelBpelProvider"/>
  </partnerLinks>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      VARIABLES                                                        
      List of messages and XML documents used within this BPEL process 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <variables>
    <!-- Reference to the message passed as input during initiation -->

    <!-- Reference to the message that will be returned to the requester-->
    <variable name="OnMessage_Book_InputVariable" messageType="client:BookReqMsg"/>
    <variable name="cancelTicket_InputVariable" messageType="client:CancelReqMsg"/>
    <variable name="replyOutput_Book_OutputVariable" messageType="client:ServiceRespMsg"/>
  </variables>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
     ORCHESTRATION LOGIC                                               
     Set of activities coordinating the flow of messages across the    
     services integrated within this business process                  
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <sequence name="main">

    <!-- Receive input from requestor. (Note: This maps to operation defined in TravelBpel.wsdl) -->

    <!-- Generate reply to synchronous request -->
    <pick name="Pick1" createInstance="yes">
      <onMessage partnerLink="travelbpel_client" variable="OnMessage_Book_InputVariable" portType="client:TravelBpel"
                 operation="Book">
        <sequence name="Sequence1">
          <assign name="AssignBookDetails">
            <copy>
              <from>ora:getComponentInstanceId()</from>
              <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$replyOutput_Book_OutputVariable.payload/ns1:PnrNo</to>
            </copy>
            <copy>
              <from>"Your tickets booked successfully"</from>
              <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$replyOutput_Book_OutputVariable.payload/ns1:Status</to>
            </copy>
          </assign>
          <reply name="replyOutput" partnerLink="travelbpel_client" portType="client:TravelBpel" operation="Book"
                 variable="replyOutput_Book_OutputVariable"/>
        </sequence>
      </onMessage>
      <onMessage partnerLink="travelbpel_client" variable="cancelTicket_InputVariable" portType="client:TravelBpel"
                 operation="CancelTicket">
        <sequence name="Sequence2">
          <assign name="AssignCancelTicket">
            <copy>
              <from>$cancelTicket_InputVariable.payload/ns1:PnrNo</from>
              <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$replyOutput_Book_OutputVariable.payload/ns1:PnrNo</to>
            </copy>
            <copy>
              <from>"Ticket cancelled"</from>
              <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$replyOutput_Book_OutputVariable.payload/ns1:Status</to>
            </copy>
          </assign>
          <reply name="replyOutput" partnerLink="travelbpel_client" portType="client:TravelBpel" operation="Book"
                 variable="replyOutput_Book_OutputVariable" xmlns="http://docs.oasis-open.org/wsbpel/2.0/process/executable"/>
        </sequence>
      </onMessage>
    </pick>
  </sequence>
</process>