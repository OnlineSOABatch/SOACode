<?xml version="1.0" encoding="UTF-8"?> 
<schema attributeFormDefault="unqualified"
	elementFormDefault="qualified"
	targetNamespace="http://xmlns.oracle.com/OnlineBatch25/HelloWorld/HelloWorld"
	xmlns="http://www.w3.org/2001/XMLSchema">
	<element name="Request">
		<complexType>
			<sequence>
				<element name="input" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="Response">
		<complexType>
			<sequence>
				<element name="GreetingMessage" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>