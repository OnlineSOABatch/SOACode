            targetNamespace="http://www.example.org/mywork/OnlineBatch25/BusinessRulesService/SOA/Schemas/1.0"
            elementFormDefault="qualified">
  <xsd:element name="LoanRequest">
    <xsd:annotation>
      <xsd:documentation>A sample element</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="LoanID" type="xsd:int"/>
        <xsd:element name="Name" type="xsd:string"/>
        <xsd:element name="CustomerType" type="xsd:string"/>
        <xsd:element name="Employeer" type="xsd:string"/>
        <xsd:element name="Salary" type="xsd:int"/>
        <xsd:element name="RequiredAmount" type="xsd:int"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="Loanresponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="LoanID" type="xsd:int"/>
        <xsd:element name="RI" type="xsd:int"/>
