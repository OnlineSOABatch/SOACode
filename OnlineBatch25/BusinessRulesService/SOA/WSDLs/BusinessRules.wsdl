<?xml version= '1.0' encoding= 'UTF-8' ?>
<wsdl:definitions
     name="BusinessRules"
     targetNamespace="http://xmlns.oracle.com/OnlineBatch25/BusinessRulesService/BusinessRules"
     xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
     xmlns:client="http://xmlns.oracle.com/OnlineBatch25/BusinessRulesService/BusinessRules"
     xmlns:ns1="http://www.example.org/mywork/OnlineBatch25/BusinessRulesService/SOA/Schemas/1.0"
     xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype"
     xmlns:ns2="http://www.example.org"
    >
    <plnk:partnerLinkType name="BusinessRules">
        <plnk:role name="BusinessRulesProvider" portType="client:BusinessRules"/>
    </plnk:partnerLinkType>
    <wsdl:types>
        <schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
             xmlns:client="http://xmlns.oracle.com/OnlineBatch25/BusinessRulesService/BusinessRules"
             xmlns:ns1="http://www.example.org/mywork/OnlineBatch25/BusinessRulesService/SOA/Schemas/1.0"
             xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype" xmlns:ns2="http://www.example.org">
            <import namespace="http://www.example.org/mywork/OnlineBatch25/BusinessRulesService/SOA/Schemas/1.0"
                 schemaLocation="../Schemas/LoanProcessing.xsd"/>
        </schema>
        <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
             xmlns:client="http://xmlns.oracle.com/OnlineBatch25/BusinessRulesService/BusinessRules"
             xmlns:ns1="http://www.example.org/mywork/OnlineBatch25/BusinessRulesService/SOA/Schemas/1.0"
             xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype" xmlns:ns2="http://www.example.org">
            <xsd:import namespace="http://www.example.org" schemaLocation="../Schemas/Rules.xsd"/>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="BusinessRulesRequestMessage">
        <wsdl:part name="payload" element="ns1:LoanRequest"/>
    </wsdl:message>
    <wsdl:message name="BusinessRulesResponseMessage">
        <wsdl:part name="payload" element="ns1:Loanresponse"/>
    </wsdl:message>
    <wsdl:portType name="BusinessRules">
        <wsdl:operation name="process">
            <wsdl:input message="client:BusinessRulesRequestMessage"/>
            <wsdl:output message="client:BusinessRulesResponseMessage"/>
        </wsdl:operation>
    </wsdl:portType>
</wsdl:definitions>
