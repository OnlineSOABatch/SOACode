	targetNamespace="http://xmlns.oracle.com/OnlineBatch25/Sub/Sub"
	xmlns="http://www.w3.org/2001/XMLSchema">
	<element name="process">
		<complexType>
			<sequence>
				<element name="SubA" type="int"/>
    <element name="SubB" type="int"/>
   </sequence>
